SECRET_KEY=django-insecure-movie-recommender-dev-key-change-in-prod
DEBUG=True
TMDB_API_KEY=

# Optional: enables the natural-language chat box.
# Without it the chat falls back to a local keyword parser.
ANTHROPIC_API_KEY=

# Google sign-in: OAuth Web client ID from Google Cloud console
GOOGLE_CLIENT_ID=

# Google Calendar sync: OAuth client secret and the key that encrypts stored tokens
GOOGLE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=

